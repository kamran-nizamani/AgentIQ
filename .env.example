# Copy to .env and edit. All values are optional except where noted.

# Repository the dashboard reads, as owner/name. Defaults to kamran-nizamani/AgentIQ.
AGENTIQ_GITHUB_REPOSITORY=owner/repo

# Public repositories work without a token but GitHub limits anonymous requests to
# 60 per hour. A fine-grained, read-only token (Actions, Contents, Pull requests,
# Metadata: read) raises that to 5,000 and allows private repositories.
GITHUB_TOKEN=
