{
  "name": "agentiq",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral evaluation engine for AI coding agents.",
  "type": "module",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --workspace @agentiq/web run dev",
    "dev": "concurrently -k \"npm run api:dev\" \"npm run web:dev\"",
    "api:dev": "npm --workspace @agentiq/api run dev",
    "api:start": "npm --workspace @agentiq/api run start",
    "api:typecheck": "npm --workspace @agentiq/api run typecheck",
    "web:build": "npm --workspace @agentiq/web run build",
    "web:typecheck": "npm --workspace @agentiq/web run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
